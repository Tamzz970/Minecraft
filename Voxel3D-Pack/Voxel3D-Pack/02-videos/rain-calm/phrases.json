[
 {
  "text": "Kenapa suara hujan membuat kita tenang?",
  "tag": "",
  "a": 0.0,
  "b": 2.345
 },
 {
  "text": "Suaranya stabil dan berulang,",
  "tag": "",
  "a": 3.126,
  "b": 4.919
 },
 {
  "text": "seperti dengung lembut yang tidak pernah mengejutkan.",
  "tag": "",
  "a": 5.387,
  "b": 7.929
 },
 {
  "text": "Otak menandainya aman,",
  "tag": "",
  "a": 8.54,
  "b": 9.936
 },
 {
  "text": "dan bunyi tajam di sekitar jadi tersamarkan.",
  "tag": "",
  "a": 10.314,
  "b": 12.789
 },
 {
  "text": "Ditambah lagi, hujan sering datang bersama rasa hangat di dalam ruangan.",
  "tag": "",
  "a": 13.279,
  "b": 17.174
 },
 {
  "text": "",
  "tag": "[sighs]",
  "a": 17.699,
  "b": 18.196
 },
 {
  "text": "Jadi saat hujan turun,",
  "tag": "",
  "a": 18.605,
  "b": 20.097
 },
 {
  "text": "biarkan dirimu istirahat sejenak.",
  "tag": "",
  "a": 20.485,
  "b": 22.517
 }
]