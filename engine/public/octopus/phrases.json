[
 {
  "text": "A big fish shot toward",
  "tag": "",
  "a": 0.0,
  "b": 1.238
 },
 {
  "text": "the little octopus.",
  "tag": "",
  "a": 1.238,
  "b": 2.476
 },
 {
  "text": "No time to lose!",
  "tag": "",
  "a": 2.92,
  "b": 4.079
 },
 {
  "text": "The octopus squirted water",
  "tag": "",
  "a": 4.608,
  "b": 6.224
 },
 {
  "text": "from its body",
  "tag": "",
  "a": 6.224,
  "b": 6.83
 },
 {
  "text": "and zoomed away,",
  "tag": "",
  "a": 6.83,
  "b": 7.84
 },
 {
  "text": "swimming as hard as it could.",
  "tag": "",
  "a": 7.84,
  "b": 9.254
 },
 {
  "text": "But inside its body,",
  "tag": "",
  "a": 9.876,
  "b": 11.064
 },
 {
  "text": "something strange",
  "tag": "",
  "a": 11.064,
  "b": 12.053
 },
 {
  "text": "was happening.",
  "tag": "",
  "a": 12.053,
  "b": 12.844
 },
 {
  "text": "One of its three hearts",
  "tag": "",
  "a": 13.463,
  "b": 14.649
 },
 {
  "text": "stopped beating.",
  "tag": "",
  "a": 14.649,
  "b": 15.44
 },
 {
  "text": "It was the big heart,",
  "tag": "",
  "a": 16.531,
  "b": 17.531
 },
 {
  "text": "the one that sends blood",
  "tag": "",
  "a": 17.531,
  "b": 18.731
 },
 {
  "text": "through the whole body.",
  "tag": "",
  "a": 18.731,
  "b": 19.731
 },
 {
  "text": "Every time an octopus swims,",
  "tag": "",
  "a": 20.257,
  "b": 22.252
 },
 {
  "text": "that heart goes quiet.",
  "tag": "",
  "a": 22.252,
  "b": 23.139
 },
 {
  "text": "The other two hearts",
  "tag": "",
  "a": 23.723,
  "b": 24.716
 },
 {
  "text": "kept beating,",
  "tag": "",
  "a": 24.716,
  "b": 25.312
 },
 {
  "text": "pushing blood through the gills",
  "tag": "",
  "a": 25.312,
  "b": 26.503
 },
 {
  "text": "to take oxygen from the water.",
  "tag": "",
  "a": 26.503,
  "b": 28.291
 },
 {
  "text": "Its blood is blue,",
  "tag": "",
  "a": 28.801,
  "b": 29.513
 },
 {
  "text": "because it contains copper,",
  "tag": "",
  "a": 29.513,
  "b": 30.937
 },
 {
  "text": "a metal used to make wires.",
  "tag": "",
  "a": 30.937,
  "b": 32.718
 },
 {
  "text": "That blue blood carries oxygen,",
  "tag": "",
  "a": 33.109,
  "b": 34.855
 },
 {
  "text": "but without the big heart,",
  "tag": "",
  "a": 34.855,
  "b": 36.351
 },
 {
  "text": "its body gets tired fast.",
  "tag": "",
  "a": 36.351,
  "b": 37.848
 },
 {
  "text": "The octopus slipped",
  "tag": "",
  "a": 38.339,
  "b": 39.409
 },
 {
  "text": "into a crack in the rocks.",
  "tag": "",
  "a": 39.409,
  "b": 40.658
 },
 {
  "text": "The big fish circled around,",
  "tag": "",
  "a": 41.062,
  "b": 42.631
 },
 {
  "text": "then swam away.",
  "tag": "",
  "a": 42.631,
  "b": 43.528
 },
 {
  "text": "Slowly, the heart",
  "tag": "",
  "a": 44.036,
  "b": 44.74
 },
 {
  "text": "that had stopped",
  "tag": "",
  "a": 44.74,
  "b": 45.679
 },
 {
  "text": "began to beat again.",
  "tag": "",
  "a": 45.679,
  "b": 47.088
 },
 {
  "text": "This time, the octopus",
  "tag": "",
  "a": 47.605,
  "b": 49.056
 },
 {
  "text": "did not swim.",
  "tag": "",
  "a": 49.056,
  "b": 49.678
 },
 {
  "text": "It crawled along",
  "tag": "",
  "a": 50.187,
  "b": 51.303
 },
 {
  "text": "the sea floor,",
  "tag": "",
  "a": 51.303,
  "b": 51.972
 },
 {
  "text": "and all three of its hearts",
  "tag": "",
  "a": 51.972,
  "b": 53.311
 },
 {
  "text": "beat together.",
  "tag": "",
  "a": 53.311,
  "b": 54.204
 }
]